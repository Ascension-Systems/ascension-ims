NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
VERIFY_REP_EMAIL=
VERIFY_REP_PASSWORD=
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=
VERIFY_THROWAWAY_PASSWORD=

# --- Push notifications (APNs, direct — see lib/push.ts). All server-side only. ---
# When any of the four APNS_ vars is unset, push is a silent no-op; the app works normally.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
# The FULL contents of the AuthKey_XXXXXXXXXX.p8 file, pasted as one value (newlines may be
# entered as literal \n). Set this in the Netlify dashboard, never commit it anywhere.
APNS_PRIVATE_KEY=
# Shared secret that authenticates the scheduled digest caller (netlify/functions/daily-digest.mjs
# -> /api/push/digest). Any long random string.
PUSH_CRON_SECRET=
# Optional: qty_available at or below this pushes a low-stock alert to admins. Default 5.
PUSH_LOW_STOCK_THRESHOLD=
